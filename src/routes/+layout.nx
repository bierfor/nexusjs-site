---
import { resolveLocale, createT, langHref } from '$lib/i18n.ts';
import { NAV_SECTIONS } from '$lib/nav.ts';
import { readFileSync } from 'node:fs';
import { createRequire } from 'node:module';

function getFrameworkVersion() {
  try {
    const req = createRequire(import.meta.url);
    const pkgPath = req.resolve('@nexus_js/server/package.json');
    const pkg = JSON.parse(readFileSync(pkgPath, 'utf8'));
    return pkg.version || '0.9.24';
  } catch {
    return '0.9.24';
  }
}

export async function load(ctx) {
  const locale = resolveLocale(ctx);
  ctx.setCookie('nx_lang', locale, {
    httpOnly: false,
    secure: true,
    sameSite: 'lax',
    maxAge: 60 * 60 * 24 * 365,
    path: '/',
  });
  const t = createT(locale);
  const langLinks = {
    en: langHref(ctx.url, 'en'),
    es: langHref(ctx.url, 'es'),
    pt: langHref(ctx.url, 'pt'),
  };
  const version = getFrameworkVersion();

  // Auto-injected head metadata via the renderer
  const head = {
    title: t('meta.title'),
    description: t('meta.description'),
    canonical: `https://nexusjs.dev${ctx.url.pathname}`,
    og: {
      type: 'website',
      url: `https://nexusjs.dev${ctx.url.pathname}`,
      siteName: 'Nexus.js',
      image: '/nexus-logo.svg',
    },
    twitter: {
      card: 'summary',
      site: '@nexusjs',
    },
  };

  return { locale, t, langLinks, navSections: NAV_SECTIONS, head, version, cspNonce: ctx.cspNonce };
}
---

<!DOCTYPE html>
<html lang="{pretext.locale}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#fafafa">
  <link rel="icon" href="/nexus-logo.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400..700;1,400..700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <!--nexus:head-->
</head>
<body class="bg-bg text-text font-sans text-[15px] leading-[1.65] tracking-[-0.01em] antialiased">
  <!-- Read progress bar (kept minimal custom for JS transform) -->
  <div class="fixed top-0 left-0 right-0 h-[3px] z-[1000] bg-transparent" id="read-progress">
    <div class="h-full bg-gradient-to-r from-accent2 to-accent-soft transform scale-x-0 origin-left transition-transform duration-100 linear" id="read-progress-bar"></div>
  </div>

  <!-- Mobile nav toggle (Tailwind) -->
  <button type="button" class="md:hidden fixed top-3 left-3 z-[110] w-9 h-9 border border-border rounded-xl bg-bg2 cursor-pointer flex-col items-center justify-center gap-[3px] shadow-sm active:scale-[0.96] transition nav-toggle-btn" id="nav-toggle" aria-expanded="false" aria-label="Open menu">
    <span class="block w-[17px] h-px bg-text transition-all"></span>
    <span class="block w-[17px] h-px bg-text transition-all"></span>
    <span class="block w-[17px] h-px bg-text transition-all"></span>
  </button>
  <div class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-[105]" id="nav-backdrop" aria-hidden="true"></div>

  <!-- Sidebar - now using Tailwind utilities + CSS vars for theming -->
  <aside class="fixed left-0 top-0 bottom-0 w-[272px] bg-[var(--surface)] border-r border-border overflow-y-auto z-[100] hidden md:block" id="sidebar">
    <div class="flex items-center gap-2 px-5 py-4 border-b border-border bg-[var(--bg2)]">
      <a href="/" class="group flex flex-1 items-center gap-3 min-w-0 transition-all duration-200 hover:bg-surface/60 -mx-1 px-1 py-1 rounded-lg">
        <div class="logo-n w-9 h-9 rounded-xl flex items-center justify-center font-black text-[22px] shadow-sm group-hover:scale-[1.03] group-hover:border-black/30 transition-all ring-1 ring-black/5 flex-shrink-0">N</div>
        <div class="flex flex-col min-w-0">
          <span class="font-semibold text-[17px] tracking-[-0.015em] text-text">Nexus</span>
          <span class="text-[10px] text-muted -mt-0.5">Framework</span>
        </div>
      </a>
      <a href="/releases{pretext.locale !== 'en' ? '?lang=' + pretext.locale : ''}" class="ml-auto text-[10px] font-mono text-muted bg-surface border border-border px-1.5 py-px rounded-full hover:border-accent2/40 hover:text-accent2 transition-colors flex-shrink-0" title="Ver releases">v{pretext.version}</a>
    </div>

    <div class="px-4 py-2.5 border-b border-border bg-[var(--bg2)]">
      <div class="inline-flex gap-0.5 p-0.5 bg-surface/60 rounded-lg border border-border/60">
        <a href="{pretext.langLinks.en}" class="lang-switch px-2.5 py-0.5 text-[11px] font-medium tracking-wider rounded-md transition-all {pretext.locale === 'en' ? 'bg-[var(--bg2)] text-text shadow-sm border border-border' : 'text-muted hover:text-text hover:bg-[var(--bg2)]/70'}" data-nx-prefetch="false">EN</a>
        <a href="{pretext.langLinks.es}" class="lang-switch px-2.5 py-0.5 text-[11px] font-medium tracking-wider rounded-md transition-all {pretext.locale === 'es' ? 'bg-[var(--bg2)] text-text shadow-sm border border-border' : 'text-muted hover:text-text hover:bg-[var(--bg2)]/70'}" data-nx-prefetch="false">ES</a>
        <a href="{pretext.langLinks.pt}" class="lang-switch px-2.5 py-0.5 text-[11px] font-medium tracking-wider rounded-md transition-all {pretext.locale === 'pt' ? 'bg-[var(--bg2)] text-text shadow-sm border border-border' : 'text-muted hover:text-text hover:bg-[var(--bg2)]/70'}" data-nx-prefetch="false">PT</a>
      </div>
    </div>

    <nav id="sidebar-nav" class="p-2 text-sm">
      <div class="px-3 py-1">
        <label for="nav-filter" class="sr-only">Filter navigation</label>
        <div class="relative">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-muted pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <input type="search" class="w-full pl-8 pr-8 py-1.5 text-[13px] border border-border rounded-lg bg-surface placeholder:text-muted focus:outline-none focus:border-accent2 focus:ring-1 focus:ring-accent2/20 transition-all" id="nav-filter" placeholder="Filter docs…" autocomplete="off" spellcheck="false">
          <button type="button" id="nav-filter-clear" class="hidden absolute right-2 top-1/2 -translate-y-1/2 w-4 h-4 rounded-full bg-muted/30 hover:bg-muted/50 flex items-center justify-center text-[10px] text-muted leading-none" aria-label="Clear filter">×</button>
        </div>
      </div>

      {#each pretext.navSections as section}
        <div class="nav-section px-3 pt-4 pb-0.5 text-[10px] font-semibold tracking-[0.08em] text-muted/90 uppercase select-none">{pretext.t(section.labelKey)}</div>
        {#each section.items as item}
          <a href="/docs/{item.slug}{pretext.locale !== 'en' ? '?lang=' + pretext.locale : ''}" class="nav-link group flex items-center gap-2 px-3 py-[7px] rounded-lg hover:bg-surface active:bg-[var(--surface)] transition-all duration-150 relative overflow-hidden" data-slug="{item.slug}" data-nx-prefetch="hover">
            <span class="absolute left-0 top-1/2 -translate-y-1/2 w-[3px] h-0 bg-accent2 rounded-r-full transition-all duration-200 group-hover:h-[60%] opacity-0 group-hover:opacity-100"></span>
            <span class="text-[15px] w-5 opacity-90">{item.emoji}</span>
            <span class="text-[13px] text-text/90 group-hover:text-text transition-colors">{pretext.t(item.labelKey)}</span>
          </a>
        {/each}
      {/each}

      <div class="nav-section px-3 pt-4 pb-0.5 text-[10px] font-semibold tracking-[0.08em] text-muted/90 uppercase select-none">More</div>
      <a href="/releases{pretext.locale !== 'en' ? '?lang=' + pretext.locale : ''}" class="nav-link group flex items-center gap-2 px-3 py-[7px] rounded-lg hover:bg-surface active:bg-[var(--surface)] transition-all duration-150 relative overflow-hidden" data-nx-prefetch="hover">
        <span class="absolute left-0 top-1/2 -translate-y-1/2 w-[3px] h-0 bg-accent2 rounded-r-full transition-all duration-200 group-hover:h-[60%] opacity-0 group-hover:opacity-100"></span>
        <span class="text-[15px] w-5 opacity-90">📋</span>
        <span class="text-[13px] text-text/90 group-hover:text-text transition-colors">Releases</span>
      </a>
    </nav>
  </aside>

  <!-- Main content area -->
  <main class="md:ml-[272px] min-h-screen">
    <!--nexus:slot-->
  </main>

  <!-- To top button (Tailwind) -->
  <button type="button" class="fixed bottom-6 right-6 w-11 h-11 rounded-full border border-border bg-bg2 text-muted flex items-center justify-center text-xl shadow-md opacity-0 translate-y-2 transition-all z-[90] hover:text-text hover:bg-surface" id="to-top" aria-label="Back to top">↑</button>

  <footer class="md:ml-[272px] mt-8 border-t border-border py-6 text-sm text-muted text-center">
    <div class="flex flex-col md:flex-row items-center justify-center gap-x-4 gap-y-1">
      <span>Built with Nexus v{pretext.version} • Docs powered by load + pretext + @nexus_js/content</span>
      <a href="https://github.com/bierfor/nexus" target="_blank" rel="noopener noreferrer" class="text-accent2 hover:underline">GitHub</a>
    </div>
  </footer>

  <nexus-island client:idle src="$lib/islands/nav.ts"></nexus-island>
  <nexus-island client:idle src="$lib/islands/progress.ts"></nexus-island>
  <nexus-island client:idle src="$lib/islands/code-copy.ts"></nexus-island>
</body>
</html>

<style nonce="{pretext.cspNonce}">
  /* Minimal JS-driven state only (global.css owns the visual styles for the left tab/sidebar) */
  #read-progress-bar { transition: transform 0.1s linear; }
  #nav-backdrop.is-visible { display: block !important; }
</style>
