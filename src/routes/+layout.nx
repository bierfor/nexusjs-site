---
import { resolveLocale, createT, langHref } from '$lib/i18n.ts';
import { NAV_SECTIONS } from '$lib/nav.ts';

export async function load(ctx) {
  const locale = resolveLocale(ctx);
  ctx.setCookie('nx_lang', locale, {
    httpOnly: false,
    secure: true,
    sameSite: 'lax',
    maxAge: 60 * 60 * 24 * 365,
    path: '/',
  });
  const t = createT(locale);
  const langLinks = {
    en: langHref(ctx.url, 'en'),
    es: langHref(ctx.url, 'es'),
    pt: langHref(ctx.url, 'pt'),
  };

  // Auto-injected head metadata via the renderer
  const head = {
    title: t('meta.title'),
    description: t('meta.description'),
    canonical: `https://nexusjs.dev${ctx.url.pathname}`,
    og: {
      type: 'website',
      url: `https://nexusjs.dev${ctx.url.pathname}`,
      siteName: 'Nexus.js',
      image: 'https://nexusjs.dev/nexus-logo.svg',
    },
    twitter: {
      card: 'summary',
      site: '@nexusjs',
    },
  };

  return { locale, t, langLinks, navSections: NAV_SECTIONS, head };
}
---

<!DOCTYPE html>
<html lang="{pretext.locale}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#fafafa">
  <link rel="icon" href="/nexus-logo.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400..700;1,400..700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <!--nexus:head-->
</head>
<body>
  <div class="read-progress" id="read-progress"><div class="read-progress-bar" id="read-progress-bar"></div></div>

  <button type="button" class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-label="Open menu">
    <span></span><span></span><span></span>
  </button>
  <div class="nav-backdrop" id="nav-backdrop" aria-hidden="true"></div>

  <aside class="sidebar" id="sidebar">
    <a href="/" class="sidebar-logo">
      <div class="logo-mark">N</div>
      <span class="logo-text">Nexus</span>
      <span class="logo-version">v0.9.23</span>
    </a>
    <div class="lang-bar">
      <a href="{pretext.langLinks.en}" class="lang-btn {pretext.locale === 'en' ? 'active' : ''}">EN</a>
      <a href="{pretext.langLinks.es}" class="lang-btn {pretext.locale === 'es' ? 'active' : ''}">ES</a>
      <a href="{pretext.langLinks.pt}" class="lang-btn {pretext.locale === 'pt' ? 'active' : ''}">PT</a>
    </div>
    <nav id="sidebar-nav" class="sidebar-nav">
      <div class="nav-filter-wrap">
        <label for="nav-filter" class="visually-hidden">Filter navigation</label>
        <input type="search" class="nav-filter" id="nav-filter" placeholder="Filter sections…" autocomplete="off" spellcheck="false">
      </div>
      {#each pretext.navSections as section}
        <div class="nav-section" data-section="{section.key}">{pretext.t(section.labelKey)}</div>
        {#each section.items as item}
          <a href="/docs/{item.slug}{pretext.locale !== 'en' ? '?lang=' + pretext.locale : ''}" class="nav-link" data-slug="{item.slug}">
            <span class="nav-emoji">{item.emoji}</span>
            <span>{pretext.t(item.labelKey)}</span>
          </a>
        {/each}
      {/each}
      <div class="nav-section">More</div>
      <a href="/releases{pretext.locale !== 'en' ? '?lang=' + pretext.locale : ''}" class="nav-link">
        <span class="nav-emoji">📋</span>
        <span>Releases</span>
      </a>
    </nav>
  </aside>

  <main class="main">
    <!--nexus:slot-->
  </main>

  <button type="button" class="to-top" id="to-top" aria-label="Back to top">↑</button>

  <footer class="site-footer">
    <div class="footer-content">
      <span>Built with Nexus v0.9.23 • Docs in modo correcto (load + pretext + @nexus_js/content)</span>
      <a href="https://github.com/bierfor/nexus" target="_blank">GitHub</a>
    </div>
  </footer>

  <nexus-island client:idle src="$lib/islands/nav.ts"></nexus-island>
  <nexus-island client:idle src="$lib/islands/progress.ts"></nexus-island>
</body>
</html>

<style>
  .read-progress {
    position: fixed;
    top: 0; left: 0; right: 0;
    height: 3px;
    z-index: 1000;
    background: transparent;
  }
  .read-progress-bar {
    height: 100%;
    background: linear-gradient(90deg, var(--accent2), var(--accent-soft));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.1s linear;
  }

  .nav-toggle {
    display: none;
    position: fixed;
    top: 14px; left: 14px;
    z-index: 110;
    width: 40px; height: 40px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg2);
    cursor: pointer;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 0;
  }
  .nav-toggle span {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--text);
    border-radius: 2px;
    transition: transform 0.2s, opacity 0.2s;
  }

  .nav-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.35);
    z-index: 50;
    backdrop-filter: blur(2px);
  }

  .sidebar {
    width: var(--sidebar-w);
    height: 100vh;
    max-height: 100vh;
    background: var(--bg2);
    border-right: 1px solid var(--border);
    position: fixed;
    top: 0; left: 0;
    z-index: 60;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
  }

  .sidebar-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    padding: 22px 20px 18px;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
  }
  .logo-mark {
    width: 34px; height: 34px;
    background: linear-gradient(145deg, #18181b 0%, #3f3f46 100%);
    border-radius: 10px;
    display: grid;
    place-items: center;
    font-size: 16px;
    font-weight: 700;
    color: #fff;
    font-family: var(--mono);
    flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(0,0,0,.12);
  }
  .logo-text {
    font-size: 16px;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.02em;
  }
  .logo-version {
    font-size: 10px;
    background: var(--surface);
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 2px 7px;
    margin-left: auto;
    font-family: var(--mono);
  }

  .lang-bar {
    display: flex;
    gap: 4px;
    padding: 10px 20px;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }
  .lang-btn {
    padding: 3px 8px;
    font-size: 11px;
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
    border-radius: 6px;
    border: 1px solid transparent;
    transition: all .15s;
  }
  .lang-btn:hover { color: var(--text); background: var(--surface); }
  .lang-btn.active {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
  }

  .sidebar-nav {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    -webkit-overflow-scrolling: touch;
    padding: 12px 0 40px;
    overscroll-behavior: contain;
  }

  .nav-filter-wrap {
    padding: 0 16px 10px;
  }
  .nav-filter {
    width: 100%;
    padding: 7px 12px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    font-family: var(--sans);
    font-size: 13px;
    color: var(--text);
    outline: none;
  }
  .nav-filter:focus { border-color: var(--accent2); box-shadow: 0 0 0 3px var(--accent-muted); }
  .nav-filter::placeholder { color: var(--muted); }

  .nav-section {
    padding: 6px 20px 4px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 14px;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 20px;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 13px;
    border-left: 2px solid transparent;
    transition: color .15s, background .15s, border-color .15s;
  }
  .nav-link:hover { color: var(--text); background: rgba(0,0,0,.03); }
  .nav-link.active {
    color: var(--accent2);
    border-left-color: var(--accent2);
    background: var(--accent-muted);
    font-weight: 500;
  }
  .nav-emoji {
    font-size: 15px;
    line-height: 1;
    width: 20px;
    text-align: center;
  }

  .main {
    margin-left: var(--sidebar-w);
    min-height: 100vh;
    padding: 0;
  }

  .to-top {
    position: fixed;
    bottom: 24px;
    right: 24px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--bg2);
    color: var(--text-secondary);
    font-size: 18px;
    cursor: pointer;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity .2s, transform .2s;
    z-index: 90;
    box-shadow: var(--shadow-md);
    display: grid;
    place-items: center;
  }
  .to-top.is-visible { opacity: 1; transform: translateY(0); }
  .to-top:hover { color: var(--text); background: var(--surface); }

  .site-footer {
    margin-top: 4rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--border);
    font-size: 0.8rem;
    color: var(--muted);
    text-align: center;
  }

  .footer-content {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .footer-content a {
    color: var(--accent2);
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .nav-toggle { display: flex; }
    .sidebar {
      transform: translateX(-110%);
      transition: transform .25s ease;
      box-shadow: var(--shadow-lg);
    }
    .sidebar.is-open { transform: translateX(0); }
    .nav-backdrop.is-visible { display: block; }
    .main { margin-left: 0; }
    .to-top { bottom: 16px; right: 16px; }
  }
</style>
