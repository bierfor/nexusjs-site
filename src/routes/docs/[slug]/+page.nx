---
import { resolveLocale, createT } from '$lib/i18n.ts';
import { getDocBySlugAsync } from '$lib/docs.ts';
import { findDocBySlug } from '$lib/nav.ts';

export async function load(ctx) {
  const locale = resolveLocale(ctx);
  const slug = ctx.params.slug;
  // Extra validation at route level
  if (typeof slug !== 'string' || !/^[a-z0-9_-]+$/i.test(slug)) {
    return ctx.notFound();
  }
  const doc = await getDocBySlugAsync(slug, locale);
  const navItem = findDocBySlug(slug);

  if (!doc) {
    return ctx.notFound();
  }

  const t = createT(locale);
  const title = t(doc.titleKey) || doc.titleKey;

  // Page-specific head metadata overrides the layout defaults
  const head = {
    title: `${title} — Nexus.js`,
    description: doc.excerpt || t('meta.description'),
    canonical: `https://nexusjs.dev/docs/${slug}`,
    og: {
      type: 'article',
      url: `https://nexusjs.dev/docs/${slug}`,
      siteName: 'Nexus.js',
    },
  };

  // doc.body is already rendered HTML from @nexus_js/content (marked + sanitize)
  return {
    locale,
    slug,
    doc,
    title,
    navItem,
    renderedHTML: doc.body,
    headings: doc.headings || [],
    head,
    cspNonce: ctx.cspNonce,
  };
}
---

<div class="max-w-[860px] mx-auto px-6 pb-16 pt-8">
  <div class="mb-8 pb-5 border-b border-[var(--border)]">
    <h1 class="text-[2.1rem] font-bold tracking-[-0.025em] mb-2">{pretext.title}</h1>
    {#if pretext.navItem}
      <div class="text-sm text-[var(--muted)]">
        <span>{pretext.t('docs.section')}: {pretext.t('nav.' + pretext.navItem.section) || pretext.navItem.section}</span>
      </div>
    {/if}
  </div>

  {#if pretext.headings && pretext.headings.length > 0}
  <nav class="doc-toc float-right w-[220px] ml-8 p-3 bg-[var(--surface)] border border-[var(--border)] rounded-lg text-[0.8rem] max-h-[60vh] overflow-auto sticky top-4">
    <div class="font-semibold mb-2 text-[var(--muted)] uppercase text-[0.7rem] tracking-[0.05em]">On this page</div>
    {#each pretext.headings as h}
      <a href="#{h.id}" class="toc-link block text-[var(--text)] no-underline py-0.5 rounded hover:text-[var(--accent2)]" data-level="{h.level}">{h.text}</a>
    {/each}
  </nav>
  <nexus-island client:visible src="$lib/islands/toc.ts"></nexus-island>
  {/if}

  <div class="clear-both prose max-w-none">
    <!-- Server-rendered Markdown via @nexus_js/content in load() - modo correcto -->
    <div>
      {pretext.renderedHTML}
    </div>
  </div>

  <div class="mt-12 pt-6 border-t border-[var(--border)]">
    <a href="/docs" class="text-[var(--accent2)] font-medium no-underline hover:underline">← {pretext.t('docs.backToIndex')}</a>
    <a href="https://github.com/bierfor/nexusjs-site/edit/main/src/content/docs/{pretext.slug}.md" target="_blank" rel="noopener noreferrer" class="ml-6 text-[var(--accent2)] font-medium no-underline hover:underline">Edit this page ↗</a>
  </div>
</div>

<style nonce="{pretext.cspNonce}">
  /* Tailwind powered */
</style>

<script nonce="{pretext.cspNonce}">
  // Optional: enhance code blocks or add copy buttons later
  // For now the content is static + server rendered
</script>
