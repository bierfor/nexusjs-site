---
import { resolveLocale, createT } from '$lib/i18n.ts';
import { NAV_SECTIONS } from '$lib/nav.ts';
import { listDocs } from '$lib/docs.ts';

export async function load(ctx) {
  const locale = resolveLocale(ctx);
  const t = createT(locale);
  const dynamicDocs = listDocs(locale); // dogfood defineCollection.list() from @nexus_js/content
  return { locale, t, navSections: NAV_SECTIONS, dynamicDocCount: dynamicDocs.length, cspNonce: ctx.cspNonce };
}
---

<div class="max-w-[860px] mx-auto px-6 pb-16 pt-8">
  <h1 class="text-[2.1rem] font-bold tracking-[-0.025em] mb-2">{pretext.t('docs.indexTitle')}</h1>
  <p class="lead">{pretext.t('docs.lead')}</p>

  <div class="grid md:grid-cols-2 gap-6 mt-8">
    {#each pretext.navSections as section}
      <div class="bg-surface border border-border rounded-2xl p-5">
        <div class="font-semibold mb-3 text-sm text-muted uppercase tracking-wider">{pretext.t(section.labelKey)}</div>
        {#each section.items as item}
          <a href="/docs/{item.slug}{pretext.locale !== 'en' ? '?lang=' + pretext.locale : ''}" class="flex items-center gap-2 p-2 rounded-lg hover:bg-[var(--bg2)] text-sm">
            <span class="emoji">{item.emoji}</span>
            <span>{pretext.t(item.labelKey)}</span>
          </a>
        {/each}
      </div>
    {/each}
  </div>

  <div class="mt-10 text-sm flex items-center gap-2">
    <a href="/releases{pretext.locale !== 'en' ? '?lang=' + pretext.locale : ''}">📋 Releases</a>
    <span class="doc-count">({pretext.dynamicDocCount} docs loaded via content.list())</span>
  </div>
</div>

<style nonce="{pretext.cspNonce}">
  /* Tailwind powered */
</style>
