---
import { resolveLocale, createT, langHref } from '$lib/i18n.ts';

export async function load(ctx) {
  const locale = resolveLocale(ctx);
  const t = createT(locale);
  const langLinks = {
    en: langHref(ctx.url, 'en'),
    es: langHref(ctx.url, 'es'),
    pt: langHref(ctx.url, 'pt'),
  };

  const head = {
    title: t('meta.title'),
    description: t('meta.description'),
    canonical: 'https://nexusjs.dev/',
    og: {
      type: 'website',
      url: 'https://nexusjs.dev/',
      siteName: 'Nexus.js',
      image: '/nexus-logo.svg',
    },
    twitter: {
      card: 'summary_large_image',
      site: '@nexusjs',
    },
  };

  return { locale, t, langLinks, head, cspNonce: ctx.cspNonce };
}
---

<!-- Hero section with animated gradient background -->
<section class="hero-section relative overflow-hidden">
  <div class="hero-gradient-bg absolute inset-0 gradient-mesh pointer-events-none"></div>
  <div class="relative max-w-[780px] mx-auto px-6 pt-20 pb-12 text-center">
    <div class="hero-badge inline-flex items-center gap-2 px-3.5 py-1.5 bg-surface border border-border rounded-full text-xs font-semibold text-text-secondary mb-6 animate-fade-in-up delay-100">
      <span class="text-accent2">◆</span>
      <span>{pretext.t('hero.badge')}</span>
    </div>

    <h1 class="hero-title text-[3.25rem] font-extrabold leading-[1.1] tracking-[-0.03em] mb-4 gradient-text">{pretext.t('hero.title')}</h1>
    <p class="hero-subtitle text-[1.125rem] text-muted max-w-[560px] mx-auto mb-7 leading-[1.7]">{pretext.t('hero.subtitle')}</p>

    <div class="flex flex-wrap gap-3 justify-center mb-10">
      <a href="/docs/quickstart{pretext.locale !== 'en' ? '?lang=' + pretext.locale : ''}" class="hero-cta btn-glow inline-flex items-center gap-1.5 px-5 py-3 rounded-[10px] font-semibold text-[0.9375rem] bg-accent text-white no-underline hover:bg-[#27272a] active:translate-y-px transition shadow-md">
        {pretext.t('hero.cta1')} →
      </a>
      <a href="https://github.com/bierfor/nexus" class="hero-cta btn-glow inline-flex items-center gap-1.5 px-5 py-3 rounded-[10px] font-semibold text-[0.9375rem] bg-transparent text-text border-2 border-border-strong no-underline hover:border-text hover:bg-surface transition" target="_blank" rel="noopener noreferrer">
        {pretext.t('hero.cta2')} ↗
      </a>
    </div>

    <div class="flex justify-center gap-10 md:gap-14 flex-wrap text-sm">
      <div class="hero-stat flex flex-col items-center">
        <div class="hero-stat-number text-2xl font-semibold tracking-tight stat-number">25</div>
        <div class="text-muted text-xs">Packages</div>
      </div>
      <div class="hero-stat flex flex-col items-center">
        <div class="hero-stat-number text-2xl font-semibold tracking-tight stat-number">0 KB</div>
        <div class="text-muted text-xs">JS by Default</div>
      </div>
      <div class="hero-stat flex flex-col items-center">
        <div class="hero-stat-number text-2xl font-semibold tracking-tight stat-number">100%</div>
        <div class="text-muted text-xs">TypeScript</div>
      </div>
      <div class="hero-stat flex flex-col items-center">
        <div class="hero-stat-number text-2xl font-semibold tracking-tight stat-number">v{pretext.version}</div>
        <div class="text-muted text-xs">Latest</div>
      </div>
    </div>
  </div>
</section>

<section class="max-w-[1100px] mx-auto px-6 py-16">
  <div class="section-label uppercase tracking-[0.08em] text-xs font-semibold text-muted mb-2">{pretext.t('why.label')}</div>
  <h2 class="text-3xl font-bold tracking-tight mb-3">{pretext.t('why.title')}</h2>
  <p class="max-w-2xl text-[1.05rem] text-muted mb-10">{pretext.t('why.lead')}</p>

  <div class="grid md:grid-cols-3 gap-6">
    <div class="why-card card-shine bg-[var(--surface)] border border-border rounded-2xl p-6 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 cursor-default">
      <div class="card-emoji w-12 h-12 rounded-xl bg-amber-100 flex items-center justify-center mb-4 text-2xl emoji-hover">
        ⚡
      </div>
      <h3 class="font-semibold text-lg mb-2">{pretext.t('why.card1t')}</h3>
      <p class="text-sm text-text-secondary leading-relaxed">{pretext.t('why.card1d')}</p>
    </div>
    <div class="why-card card-shine bg-[var(--surface)] border border-border rounded-2xl p-6 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 cursor-default">
      <div class="card-emoji w-12 h-12 rounded-xl bg-emerald-100 flex items-center justify-center mb-4 text-2xl emoji-hover">
        🛡️
      </div>
      <h3 class="font-semibold text-lg mb-2">{pretext.t('why.card2t')}</h3>
      <p class="text-sm text-text-secondary leading-relaxed">{pretext.t('why.card2d')}</p>
    </div>
    <div class="why-card card-shine bg-[var(--surface)] border border-border rounded-2xl p-6 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 cursor-default">
      <div class="card-emoji w-12 h-12 rounded-xl bg-blue-100 flex items-center justify-center mb-4 text-2xl emoji-hover">
        🔍
      </div>
      <h3 class="font-semibold text-lg mb-2">{pretext.t('why.card3t')}</h3>
      <p class="text-sm text-text-secondary leading-relaxed">{pretext.t('why.card3d')}</p>
    </div>
  </div>
</section>

