</section>

<section class="cta-section max-w-[780px] mx-auto px-6 pb-20 text-center">
  <h2 class="text-3xl font-bold tracking-tight mb-3">Ready to build?</h2>
  <p class="text-muted mb-8">Start with the docs or scaffold a project in 30 seconds.</p>
  <div class="flex flex-wrap gap-3 justify-center">
    <a href="/docs/install{pretext.locale !== 'en' ? '?lang=' + pretext.locale : ''}" class="btn-glow inline-flex items-center gap-1.5 px-5 py-3 rounded-[10px] font-semibold text-[0.9375rem] bg-accent text-white no-underline hover:bg-[#27272a] shadow-md">Read the Docs →</a>
    <a href="/docs/quickstart{pretext.locale !== 'en' ? '?lang=' + pretext.locale : ''}" class="btn-glow inline-flex items-center gap-1.5 px-5 py-3 rounded-[10px] font-semibold text-[0.9375rem] bg-transparent text-text border-2 border-border-strong no-underline hover:border-text hover:bg-surface">Quick Start →</a>
