---
import { resolveLocale, createT } from '$lib/i18n.ts';

export async function load(ctx) {
  const locale = resolveLocale(ctx);
  const t = createT(locale);
  return { locale, t, cspNonce: ctx.cspNonce };
}
---

<div class="min-h-[70vh] flex items-center justify-center px-8 text-center">
  <div class="max-w-[420px]">
    <div class="text-[6rem] font-extrabold leading-none text-accent2 mb-2 tracking-[-0.05em]">404</div>
    <h1 class="text-[1.85rem] font-bold mb-3">{pretext.t('notFound.title')}</h1>
    <p class="text-[1.05rem] text-muted mb-8">{pretext.t('notFound.lead')}</p>

    <div class="flex flex-wrap gap-3 justify-center">
      <a href="/" class="inline-flex items-center px-5 py-3 rounded-[10px] font-semibold text-[0.9375rem] bg-accent text-white no-underline hover:bg-[#27272a]">{pretext.t('notFound.home')}</a>
      <a href="/docs" class="inline-flex items-center px-5 py-3 rounded-[10px] font-semibold text-[0.9375rem] bg-transparent text-text border-2 border-border-strong no-underline hover:border-text hover:bg-surface">{pretext.t('notFound.browse')}</a>
    </div>
  </div>
</div>
