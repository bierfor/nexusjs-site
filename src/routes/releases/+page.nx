---
import { resolveLocale, createT } from '$lib/i18n.ts';
import { loadContent } from '@nexus_js/content';

export async function load(ctx) {
  const locale = resolveLocale(ctx);
  const t = createT(locale);

  // Load via @nexus_js/content (modo correcto: consistent with docs, uses frontmatter/render/sanitize if needed)
  const langSuffix = locale === 'en' ? '.en' : locale === 'pt' ? '.pt' : '';
  const baseSlug = `RELEASES_0.9.x${langSuffix}`;
  const releaseItem = loadContent(baseSlug, {
    contentDir: 'docs',
    locale,
    includeRaw: true,
    sanitize: 'permissive', // release notes are trusted source; keep formatting
  });

  const releaseNotes = releaseItem.raw || releaseItem.html || 'Release notes not available for this language yet.';
  const renderedRelease = releaseItem.html || releaseNotes;

  // head for the releases page
  const head = {
    title: `${t('releases.title')} — Nexus.js`,
    description: t('releases.lead'),
    canonical: `https://nexusjs.dev/releases${locale !== 'en' ? '?lang=' + locale : ''}`,
  };

  return { locale, t, releaseNotes, renderedRelease, head };
}
---

<div class="releases-page">
  <div class="releases-header">
    <h1>{pretext.t('releases.title')}</h1>
    <p class="lead">{pretext.t('releases.lead')}</p>
  </div>

  <div class="releases-content">
    <!-- Rendered via @nexus_js/content (modo correcto) for nice HTML (headings, lists). -->
    <div class="prose release-notes">
      {pretext.renderedRelease}
    </div>

    <details class="raw-source">
      <summary>View raw Markdown source</summary>
      <pre><code>{pretext.releaseNotes}</code></pre>
    </details>
  </div>

  <div class="releases-footer">
    <p>Full source available in the <a href="https://github.com/bierfor/nexus" target="_blank">GitHub repository</a>.</p>
  </div>
</div>

<style>
  .releases-page {
    max-width: 920px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .releases-header {
    margin-bottom: 2rem;
  }

  .releases-header h1 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .releases-content {
    background: #0f0f11;
    color: #e4e4e7;
    padding: 1.5rem;
    border-radius: 12px;
    overflow-x: auto;
    font-size: 14px;
    line-height: 1.55;
  }

  .releases-content pre {
    margin: 0;
    white-space: pre-wrap;
    font-family: var(--mono);
  }

  .releases-footer {
    margin-top: 2rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .raw-source {
    margin-top: 1.5rem;
    border-top: 1px solid #333;
    padding-top: 1rem;
  }

  .raw-source summary {
    cursor: pointer;
    color: var(--accent2);
    font-size: 0.85rem;
  }

  .raw-source pre {
    background: #0a0a0c;
    padding: 1rem;
    border-radius: 8px;
    font-size: 12px;
    margin-top: 0.5rem;
    overflow: auto;
  }
</style>
